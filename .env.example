# Environment Variables for Northwind Scheduling Assistant

# -----------------------------------------------------------
# Option 1: Google Gemini API (Recommended for live testing)
# -----------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# -----------------------------------------------------------
# Option 2: OpenAI or OpenAI-Compatible Endpoints (e.g. Ollama, Azure, vLLM)
# -----------------------------------------------------------
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
# LLM_API_KEY=optional_key_if_required

